  <metadata>
    <name>Mae Hong Son Loop</name>
    <desc>The legendary 600km motorcycle loop through Northern Thailand</desc>
  </metadata>
  <trk>
    <name>Mae Hong Son Loop (Clockwise)</name>
    <trkseg>
      <!-- Chiang Mai -->
      <trkpt lat="18.7883" lon="98.9853"><ele>310</ele></trkpt>
      <trkpt lat="18.8100" lon="98.9700"><ele>330</ele></trkpt>
      <trkpt lat="18.8450" lon="98.9400"><ele>380</ele></trkpt>
      <!-- Climbing north toward Mae Taeng -->
      <trkpt lat="18.9200" lon="98.9100"><ele>420</ele></trkpt>
      <trkpt lat="18.9800" lon="98.8800"><ele>510</ele></trkpt>
      <trkpt lat="19.0400" lon="98.8500"><ele>620</ele></trkpt>
      <!-- Climbing toward Pai -->
      <trkpt lat="19.1000" lon="98.8200"><ele>780</ele></trkpt>
      <trkpt lat="19.1500" lon="98.7900"><ele>920</ele></trkpt>
      <trkpt lat="19.2000" lon="98.7500"><ele>1080</ele></trkpt>
      <trkpt lat="19.2400" lon="98.7100"><ele>1220</ele></trkpt>
      <!-- Summit before Pai -->
      <trkpt lat="19.2800" lon="98.6800"><ele>1380</ele></trkpt>
      <trkpt lat="19.3100" lon="98.6500"><ele>1150</ele></trkpt>
      <!-- Descending to Pai -->
      <trkpt lat="19.3400" lon="98.6200"><ele>920</ele></trkpt>
      <trkpt lat="19.3580" lon="98.4440"><ele>630</ele></trkpt>
      <!-- Pai -->
      <trkpt lat="19.3590" lon="98.4400"><ele>580</ele></trkpt>
      <!-- Pai to Mae Hong Son -->
      <trkpt lat="19.3400" lon="98.3800"><ele>640</ele></trkpt>
      <trkpt lat="19.3100" lon="98.3200"><ele>820</ele></trkpt>
      <trkpt lat="19.2800" lon="98.2600"><ele>1050</ele></trkpt>
      <trkpt lat="19.2600" lon="98.2000"><ele>1280</ele></trkpt>
      <!-- Soppong / Pangmapha -->
      <trkpt lat="19.4500" lon="98.2200"><ele>850</ele></trkpt>
      <trkpt lat="19.5000" lon="98.1800"><ele>720</ele></trkpt>
      <!-- Approaching Mae Hong Son -->
      <trkpt lat="19.4500" lon="97.9800"><ele>600</ele></trkpt>
      <trkpt lat="19.3500" lon="97.9500"><ele>450</ele></trkpt>
      <!-- Mae Hong Son -->
      <trkpt lat="19.3020" lon="97.9654"><ele>280</ele></trkpt>
      <!-- Mae Hong Son to Khun Yuam -->
      <trkpt lat="19.2000" lon="97.9500"><ele>350</ele></trkpt>
      <trkpt lat="19.0500" lon="97.9400"><ele>480</ele></trkpt>
      <trkpt lat="18.8500" lon="97.9300"><ele>620</ele></trkpt>
      <!-- Khun Yuam -->
      <trkpt lat="18.8137" lon="97.9370"><ele>560</ele></trkpt>
      <!-- Khun Yuam to Mae Sariang -->
      <trkpt lat="18.7000" lon="97.9200"><ele>680</ele></trkpt>
      <trkpt lat="18.5500" lon="97.9400"><ele>520</ele></trkpt>
      <!-- Mae Sariang -->
      <trkpt lat="18.1710" lon="97.9330"><ele>240</ele></trkpt>
      <!-- Mae Sariang to Hot -->
      <trkpt lat="18.1500" lon="98.0000"><ele>320</ele></trkpt>
      <trkpt lat="18.2000" lon="98.1500"><ele>450</ele></trkpt>
      <trkpt lat="18.2500" lon="98.2500"><ele>720</ele></trkpt>
      <trkpt lat="18.3000" lon="98.3500"><ele>980</ele></trkpt>
      <!-- Ob Luang Gorge area -->
      <trkpt lat="18.3200" lon="98.4000"><ele>1100</ele></trkpt>
      <trkpt lat="18.3500" lon="98.4500"><ele>850</ele></trkpt>
      <!-- Hot -->
      <trkpt lat="18.3900" lon="98.5600"><ele>350</ele></trkpt>
      <!-- Hot back to Chiang Mai -->
      <trkpt lat="18.4500" lon="98.6500"><ele>380</ele></trkpt>
      <trkpt lat="18.5500" lon="98.7500"><ele>340</ele></trkpt>
      <trkpt lat="18.6500" lon="98.8500"><ele>320</ele></trkpt>
      <trkpt lat="18.7200" lon="98.9200"><ele>310</ele></trkpt>
      <!-- Back to Chiang Mai -->
      <trkpt lat="18.7883" lon="98.9853"><ele>310</ele></trkpt>
    </trkseg>
  </trk>
