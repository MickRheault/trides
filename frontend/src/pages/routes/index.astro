---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRoutes, getStrapiMediaUrl } from '../../lib/strapi';

// Try to fetch routes from Strapi, fall back to mock data
let routes = await getRoutes();

if (routes.length === 0) {
  routes = [
    {
      id: 1, documentId: '1',
      title: 'Mae Hong Son Loop', slug: 'mae-hong-son-loop',
      description: '', excerpt: 'The legendary 600km loop through Northern Thailand\'s most dramatic mountain scenery. Winding roads, hill tribe villages, and breathtaking viewpoints.',
      difficulty: 'intermediate', road_types: [{ id: 1, documentId: 'rt1', name: 'paved' }],
      motorcycles: [{ id: 1, documentId: 'mc1', name: 'Touring' }, { id: 2, documentId: 'mc2', name: 'Adventure' }],
      region: 'north',
    },
    {
      id: 2, documentId: '2',
      title: 'Doi Inthanon Summit', slug: 'doi-inthanon-summit',
      description: '', excerpt: 'Ride to the rooftop of Thailand. The highest peak at 2,565m offers cool temperatures, cascading waterfalls, and royal pagodas in the clouds.',
      difficulty: 'beginner', road_types: [{ id: 1, documentId: 'rt1', name: 'paved' }],
      motorcycles: [{ id: 3, documentId: 'mc3', name: 'Scooter' }, { id: 1, documentId: 'mc1', name: 'Touring' }],
      region: 'north',
    },
    {
      id: 3, documentId: '3',
      title: 'Pai Canyon Run', slug: 'pai-canyon-run',
      description: '', excerpt: 'Navigate 762 curves from Chiang Mai to the laidback town of Pai. A challenging ride rewarded with hot springs, waterfalls, and stunning sunsets.',
      difficulty: 'advanced', road_types: [{ id: 2, documentId: 'rt2', name: 'mixed' }],
      motorcycles: [{ id: 2, documentId: 'mc2', name: 'Adventure' }, { id: 4, documentId: 'mc4', name: 'Dual Sport' }],
      region: 'north',
    },
    {
      id: 4, documentId: '4',
      title: 'Samoeng Loop', slug: 'samoeng-loop',
      description: '', excerpt: 'A perfect half-day loop from Chiang Mai through rural countryside, villages, and gentle mountain roads. Great for beginners.',
      difficulty: 'beginner', road_types: [{ id: 1, documentId: 'rt1', name: 'paved' }],
      motorcycles: [{ id: 3, documentId: 'mc3', name: 'Scooter' }],
      region: 'north',
    },
    {
      id: 5, documentId: '5',
      title: 'Golden Triangle Border Run', slug: 'golden-triangle-border-run',
      description: '', excerpt: 'Ride along the Mekong River to where Thailand, Laos, and Myanmar meet. A historic and scenic journey through Chiang Rai province.',
      difficulty: 'intermediate', road_types: [{ id: 1, documentId: 'rt1', name: 'paved' }],
      motorcycles: [{ id: 1, documentId: 'mc1', name: 'Touring' }],
      region: 'north',
    },
    {
      id: 6, documentId: '6',
      title: 'Khao Sok Jungle Ride', slug: 'khao-sok-jungle-ride',
      description: '', excerpt: 'Cut through the dense rainforests of Southern Thailand to reach Khao Sok National Park. Limestone cliffs, hidden lakes, and wild monkeys.',
      difficulty: 'intermediate', road_types: [{ id: 2, documentId: 'rt2', name: 'mixed' }],
      motorcycles: [{ id: 2, documentId: 'mc2', name: 'Adventure' }, { id: 4, documentId: 'mc4', name: 'Dual Sport' }],
      region: 'south',
    },
  ] as any;
}
---

<BaseLayout title="Routes" description="Browse all motorcycle routes across Thailand. Filter by region, difficulty, and distance.">
  <div class="page-header">
    <div class="container">
      <span class="section__label">Explore</span>
      <h1 class="page-header__title">All Routes</h1>
      <p class="page-header__description">
        Discover curated motorcycle routes across every region of Thailand.
      </p>
    </div>
  </div>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <!-- Filter Bar -->
      <div class="filter-bar" id="filter-bar">
        <button class="filter-btn filter-btn--active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="north">North</button>
        <button class="filter-btn" data-filter="central">Central</button>
        <button class="filter-btn" data-filter="south">South</button>
        <button class="filter-btn" data-filter="east">East</button>
        <button class="filter-btn" data-filter="west">West</button>
        <button class="filter-btn" data-filter="isaan">Isaan</button>
        <span style="width: 1px; background: var(--color-border); margin: 0 var(--space-2);"></span>
        <button class="filter-btn" data-filter="beginner">Beginner</button>
        <button class="filter-btn" data-filter="intermediate">Intermediate</button>
        <button class="filter-btn" data-filter="advanced">Advanced</button>
      </div>

      <!-- Route Grid -->
      <div class="routes-grid" id="routes-grid">
        {routes.map((route) => (
          <a href={`/routes/${route.slug}`} class="route-card" id={`route-${route.slug}`} data-region={route.region} data-difficulty={route.difficulty}>
            <div class="route-card__image">
              {route.hero_image?.url ? (
                <img src={getStrapiMediaUrl(route.hero_image.url)} alt={route.hero_image?.alternativeText || route.title} style="width: 100%; height: 100%; object-fit: cover;" />
              ) : (
                <div style="width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-surface), var(--color-bg-elevated)); display: flex; align-items: center; justify-content: center; color: var(--color-text-muted); font-size: var(--text-3xl);">
                  🏔️
                </div>
              )}
              <span class={`route-card__difficulty route-card__difficulty--${route.difficulty}`}>
                {route.difficulty}
              </span>
            </div>
            <div class="route-card__body">
              <span class="route-card__region">{({'north':'North','south':'South','central':'Central','east':'East','west':'West','isaan':'Isaan'} as any)[route.region] ?? route.region} Thailand</span>
              <h3 class="route-card__title">{route.title}</h3>
              <p class="route-card__excerpt">{route.excerpt}</p>
              
              {route.motorcycles && route.motorcycles.length > 0 && (
                <div style="display: flex; gap: 0.25rem; flex-wrap: wrap; margin-bottom: 0.5rem; gap: 4px;">
                  {route.motorcycles.map((mc: any) => (
                    <span style="background: var(--color-bg-elevated); border: 1px solid var(--color-border); padding: 2px 8px; border-radius: 4px; font-size: var(--text-xs); color: var(--color-text-muted);">
                    {mc.name}
                    </span>
                  ))}
                </div>
              )}
              
              <div class="route-card__stats">
                <div class="route-card__stat">
                  <strong>{route.distance_km} km</strong>
                </div>
                <div class="route-card__stat">
                  <strong>{route.estimated_hours}h</strong> ride
                </div>
                <div class="route-card__stat">
                  <strong>{route.road_types?.map((rt: any) => rt.name).join(', ') || 'N/A'}</strong>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Client-side filtering
  const filterBar = document.getElementById('filter-bar');
  const routeCards = document.querySelectorAll('.route-card') as NodeListOf<HTMLElement>;

  filterBar?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.classList.contains('filter-btn')) return;

    const filter = target.dataset.filter;

    // Toggle active state
    filterBar.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('filter-btn--active'));
    target.classList.add('filter-btn--active');

    // Filter cards
    routeCards.forEach(card => {
      if (filter === 'all') {
        card.style.display = '';
        return;
      }
      const region = card.dataset.region;
      const difficulty = card.dataset.difficulty;
      const matches = region === filter || difficulty === filter;
      card.style.display = matches ? '' : 'none';
    });
  });
</script>
