---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRoutes, getRouteBySlug, getStrapiMediaUrl } from '../../lib/strapi';
import { marked } from 'marked';

/** Convert Strapi richtext (markdown) to HTML */
function renderDescription(text: string): string {
  if (!text) return '';
  // If already contains HTML tags, return as-is (mock data)
  if (text.includes('<p>') || text.includes('<br')) return text;
  // Parse markdown from Strapi
  return marked.parse(text, { async: false }) as string;
}

export async function getStaticPaths() {
  let routes = await getRoutes();

  if (routes.length === 0) {
    return [
      { params: { slug: 'mae-hong-son-loop' } },
      { params: { slug: 'doi-inthanon-summit' } },
      { params: { slug: 'pai-canyon-run' } },
    ];
  }

  return routes.map((route) => ({
    params: { slug: route.slug },
  }));
}

const { slug } = Astro.params;

let route = slug ? await getRouteBySlug(slug) : null;

if (!route) {
  const mockRoutes: Record<string, any> = {
    'mae-hong-son-loop': {
      id: 1, documentId: '1',
      title: 'Mae Hong Son Loop', slug: 'mae-hong-son-loop',
      description: `<p>The Mae Hong Son Loop is arguably the most famous motorcycle route in all of Thailand. This 600km circuit starts and ends in Chiang Mai, taking riders through some of the most dramatic mountain scenery in Southeast Asia.</p>
      <p>The loop passes through the towns of Pai, Mae Hong Son, and Mae Sariang, offering a perfect mix of twisting mountain roads, hill tribe villages, hot springs, waterfalls, and breathtaking viewpoints that drop into deep valleys below.</p>
      <p>The roads are well-paved throughout with plenty of fuel stops along the way. Most riders complete the loop in 3-5 days, though you could easily spend a week exploring all the side roads and hidden spots.</p>`,
      excerpt: 'The legendary 600km loop through Northern Thailand\'s most dramatic mountain scenery.',
      distance_km: 600, estimated_hours: 16, difficulty: 'intermediate', road_type: 'paved',
      region: 'north', best_months: 'November - February',
      gpx_file: '/gpx/maehongson-gardenofrocks.gpx',
      gpx_files: [
        { url: '/gpx/maehongson-gardenofrocks.gpx', name: 'Full Loop (Clockwise)' },
        { url: '#', name: 'Full Loop (Counter-clockwise)' },
        { url: '#', name: 'Pai to Mae Hong Son segment' },
      ],
      pois: [
        { name: 'Pai Walking Street', description: 'Nightly market with local food, crafts, and live music.', latitude: 19.3590, longitude: 98.4400, type: 'attraction', google_maps_url: 'https://maps.google.com/?q=19.3590,98.4400' },
        { name: 'Tham Lot Cave', description: 'Massive cave system with stalactites and a river running through it.', latitude: 19.4558, longitude: 98.2789, type: 'attraction', google_maps_url: 'https://maps.google.com/?q=19.4558,98.2789' },
        { name: 'Pha Suea Waterfall', description: 'Stunning waterfall near Mae Hong Son town.', latitude: 19.3283, longitude: 97.9261, type: 'viewpoint' },
        { name: 'PTT Gas Station Khun Yuam', description: 'Last reliable fuel stop before the long stretch south.', latitude: 18.8137, longitude: 97.9370, type: 'fuel', google_maps_url: 'https://maps.google.com/?q=18.8137,97.9370' },
        { name: 'Ob Luang Gorge', description: 'Narrow canyon with a suspension bridge. Good rest stop.', latitude: 18.3200, longitude: 98.4000, type: 'viewpoint' },
        { name: 'Steep Descent Warning', description: 'Very steep hairpin descents between Pai and Mae Hong Son. Use low gear.', latitude: 19.2800, longitude: 98.2600, type: 'warning' },
      ],
      gallery: [
        { url: 'https://picsum.photos/seed/mhs1/800/600', alternativeText: 'Mountain road with sweeping curves' },
        { url: 'https://picsum.photos/seed/mhs2/800/600', alternativeText: 'Hill tribe village along the loop' },
        { url: 'https://picsum.photos/seed/mhs3/800/600', alternativeText: 'Misty valley viewpoint' },
        { url: 'https://picsum.photos/seed/mhs4/800/600', alternativeText: 'Pai town at sunset' },
        { url: 'https://picsum.photos/seed/mhs5/800/600', alternativeText: 'Winding road through forest' },
        { url: 'https://picsum.photos/seed/mhs6/800/600', alternativeText: 'Hot springs stop' },
      ],
    },
    'doi-inthanon-summit': {
      id: 2, documentId: '2',
      title: 'Doi Inthanon Summit', slug: 'doi-inthanon-summit',
      description: `<p>Doi Inthanon is the highest mountain in Thailand, standing at 2,565 meters above sea level. The ride from Chiang Mai to the summit is a beautiful half-day trip through national park land.</p>
      <p>The route features well-maintained tarmac roads with sweeping curves through lush forest. Along the way, you'll pass stunning waterfalls (Wachirathan and Siriphum), the twin royal pagodas, and the Ang Ka Nature Trail at the summit.</p>`,
      excerpt: 'Ride to the rooftop of Thailand with cool temperatures and royal pagodas in the clouds.',
      distance_km: 120, estimated_hours: 4, difficulty: 'beginner', road_type: 'paved',
      region: 'north', best_months: 'November - March',
      gpx_file: '/gpx/maehongson-gardenofrocks.gpx',
      gpx_files: [
        { url: '#', name: 'Summit Route' },
      ],
      pois: [
        { name: 'Wachirathan Waterfall', description: 'Powerful 80m waterfall with a misty viewing area.', latitude: 18.5386, longitude: 98.5997, type: 'viewpoint' },
        { name: 'Royal Twin Pagodas', description: 'Naphamethinidon and Naphaphonphumisiri pagodas built to honor the King and Queen.', latitude: 18.5572, longitude: 98.4867, type: 'attraction', google_maps_url: 'https://maps.google.com/?q=18.5572,98.4867' },
        { name: 'Summit Restaurant', description: 'Small cafe at the summit selling coffee and Thai food.', latitude: 18.5878, longitude: 98.4864, type: 'food' },
      ],
      gallery: [
        { url: 'https://picsum.photos/seed/doi1/800/600', alternativeText: 'Road to Doi Inthanon summit' },
        { url: 'https://picsum.photos/seed/doi2/800/600', alternativeText: 'Wachirathan Waterfall' },
        { url: 'https://picsum.photos/seed/doi3/800/600', alternativeText: 'Royal Twin Pagodas in the mist' },
      ],
    },
    'pai-canyon-run': {
      id: 3, documentId: '3',
      title: 'Pai Canyon Run', slug: 'pai-canyon-run',
      description: `<p>Route 1095 from Chiang Mai to Pai is legendary for its 762 curves. This challenging ride is a rite of passage for motorcycle riders visiting Northern Thailand.</p>
      <p>The road climbs steeply from the Chiang Mai valley into the mountains, with tight switchbacks, blind corners, and steep gradients. It's not for the faint of heart, but the rewards — hot springs, jungle waterfalls, and the laidback hippie town of Pai — make every curve worthwhile.</p>`,
      excerpt: 'Navigate 762 curves from Chiang Mai to Pai. A challenging and rewarding ride.',
      distance_km: 150, estimated_hours: 5, difficulty: 'advanced', road_type: 'mixed',
      region: 'north', best_months: 'November - February',
      gpx_file: '/gpx/maehongson-gardenofrocks.gpx',
      gpx_files: [
        { url: '#', name: 'Chiang Mai to Pai' },
        { url: '#', name: 'Pai to Chiang Mai (reverse)' },
      ],
      pois: [
        { name: 'Mae Yen Waterfall', description: 'Hidden waterfall accessible by a 2-hour hike from the road.', latitude: 19.2400, longitude: 98.7100, type: 'attraction' },
        { name: 'Pai Canyon', description: 'Narrow ridgeline with spectacular views on both sides. Best at sunset.', latitude: 19.3280, longitude: 98.4810, type: 'viewpoint', google_maps_url: 'https://maps.google.com/?q=19.3280,98.4810' },
        { name: 'Pai Hot Springs', description: 'Natural hot springs in a jungle setting. Small entrance fee.', latitude: 19.3645, longitude: 98.4150, type: 'attraction' },
        { name: 'Blind Curve Zone', description: 'Multiple blind curves between km 60-80. Watch for oncoming trucks in your lane.', latitude: 19.1500, longitude: 98.7900, type: 'warning' },
      ],
      gallery: [
        { url: 'https://picsum.photos/seed/pai1/800/600', alternativeText: 'Route 1095 curves' },
        { url: 'https://picsum.photos/seed/pai2/800/600', alternativeText: 'Pai Canyon ridgeline' },
        { url: 'https://picsum.photos/seed/pai3/800/600', alternativeText: 'Jungle waterfall near Pai' },
        { url: 'https://picsum.photos/seed/pai4/800/600', alternativeText: 'Mountain road at dawn' },
      ],
    },
  };

  route = mockRoutes[slug ?? ''] ?? null;
}

if (!route) {
  return Astro.redirect('/routes');
}

const difficultyColors: Record<string, string> = {
  beginner: 'var(--color-beginner)',
  intermediate: 'var(--color-intermediate)',
  advanced: 'var(--color-advanced)',
};

// Get GPX URL: prefer Strapi media (Cloudinary), fall back to local file
const gpxUrl = route.gpx_files?.[0]?.url
  ? getStrapiMediaUrl(route.gpx_files[0].url)
  : (route.gpx_file || '/gpx/maehongson-gardenofrocks.gpx');
const heroImageUrl = route.hero_image?.url
  ? getStrapiMediaUrl(route.hero_image.url)
  : null;
---

<BaseLayout title={route.title} description={route.excerpt}>
  <div class="route-detail">
    <div class="container">
      <!-- Hero Image -->
      <div class="route-detail__hero">
        {heroImageUrl ? (
          <img src={heroImageUrl} alt={route.hero_image?.alternativeText || route.title} style="width: 100%; height: 100%; object-fit: cover;" />
        ) : (
          <div style="width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-surface), var(--color-bg-elevated), var(--color-surface)); display: flex; align-items: center; justify-content: center; color: var(--color-text-muted); font-size: 4rem;">
            🏔️
          </div>
        )}
      </div>

      <!-- Title -->
      <div class="route-detail__content">
        <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3);">
          <span class="section__label" style="margin: 0;">{route.region} Thailand</span>
          <span class={`route-card__difficulty route-card__difficulty--${route.difficulty}`}>
            {route.difficulty}
          </span>
        </div>
        <h1 style="font-family: var(--font-display); font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl)); font-weight: 900; letter-spacing: -0.03em; margin-bottom: var(--space-6);">
          {route.title}
        </h1>
        <p style="font-size: var(--text-lg); color: var(--color-text-secondary); margin-bottom: var(--space-8);">
          {route.excerpt}
        </p>
      </div>

      <!-- Stats Bar -->
      <div class="route-detail__content">
        <div class="stats-bar">
          <div class="stats-bar__item">
            <div class="stats-bar__value">{route.distance_km}</div>
            <div class="stats-bar__label">Kilometers</div>
          </div>
          <div class="stats-bar__item">
            <div class="stats-bar__value">{route.estimated_hours}h</div>
            <div class="stats-bar__label">Riding Time</div>
          </div>
          <div class="stats-bar__item">
            <div class="stats-bar__value" style={`color: ${difficultyColors[route.difficulty]}`}>{route.difficulty}</div>
            <div class="stats-bar__label">Difficulty</div>
          </div>
          <div class="stats-bar__item">
            <div class="stats-bar__value">{route.road_type}</div>
            <div class="stats-bar__label">Road Type</div>
          </div>
        </div>
      </div>

      <!-- Interactive Map with Elevation -->
      <div class="route-detail__content">
        <h2 style="font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; margin-bottom: var(--space-4);">
          Route Map & Elevation
        </h2>
        <div id="route-map" data-gpx={gpxUrl}></div>
        <div id="elevation-chart"></div>
      </div>

      <!-- Description -->
      <div class="route-detail__content">
        <h2 style="font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; margin: var(--space-10) 0 var(--space-4);">
          About This Route
        </h2>
        <div set:html={renderDescription(route.description)} />
      </div>

      <!-- Gallery -->
      {route.gallery && route.gallery.length > 0 && (
        <div class="route-detail__content">
          <h2 style="font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; margin: var(--space-10) 0 var(--space-4);">
            Photos
          </h2>
          <div class="gallery-grid">
            {route.gallery.map((img) => (
              <a href={getStrapiMediaUrl(img.url)} target="_blank" rel="noopener noreferrer" class="gallery-item">
                <img src={getStrapiMediaUrl(img.url)} alt={img.alternativeText || route.title} loading="lazy" />
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Best Months -->
      <div class="route-detail__content">
        <h2 style="font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; margin: var(--space-10) 0 var(--space-4);">
          Best Time to Ride
        </h2>
        <p style="font-size: var(--text-lg); color: var(--color-text-secondary); line-height: 1.8;">
          The recommended months for this route are <strong style="color: var(--color-accent);">{route.best_months}</strong>.
        </p>
      </div>

      <!-- GPX Downloads -->
      {route.gpx_files && route.gpx_files.length > 0 && (
        <div class="route-detail__content">
          <h2 style="font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; margin: var(--space-10) 0 var(--space-4);">
            Download GPX Tracks
          </h2>
          <div class="gpx-downloads">
            {route.gpx_files.map((file: any) => (
              <a href={file.url} class="gpx-btn" download>
                📥 {file.name}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- POIs / Points of Interest -->
      {route.pois && route.pois.length > 0 && (
        <div class="route-detail__content">
          <h2 style="font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; margin: var(--space-10) 0 var(--space-4);">
            Points of Interest
          </h2>
          <div class="poi-grid">
            {route.pois.map((poi) => (
              <div class="poi-card">
                <div class="poi-card__icon" data-poi-type={poi.type}>
                  {poi.type === 'fuel' ? '⛽' : poi.type === 'viewpoint' ? '👁️' : poi.type === 'food' ? '🍜' : poi.type === 'accommodation' ? '🏠' : poi.type === 'warning' ? '⚠️' : '⭐'}
                </div>
                <div class="poi-card__content">
                  <div class="poi-card__header">
                    <h3 class="poi-card__name">{poi.name}</h3>
                    <span class="poi-card__type">{poi.type}</span>
                  </div>
                  {poi.description && (
                    <p class="poi-card__desc">{poi.description}</p>
                  )}
                  <div class="poi-card__meta">
                    {poi.google_maps_url && (
                      <a href={poi.google_maps_url} target="_blank" rel="noopener noreferrer" class="poi-card__maps-link">
                        📍 Open in Google Maps ↗
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Back link -->
      <div class="route-detail__content" style="padding: var(--space-16) 0;">
        <a href="/routes" class="btn btn--secondary">← Back to All Routes</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  #route-map {
    width: 100%;
    height: 500px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--color-border);
    position: relative;
    z-index: 1;
  }

  #elevation-chart {
    margin-top: var(--space-4);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* Leaflet dark theme overrides */
  :global(.leaflet-container) {
    background: var(--color-surface) !important;
  }

  :global(.leaflet-control-zoom a) {
    background: var(--color-surface) !important;
    color: var(--color-text) !important;
    border-color: var(--color-border) !important;
  }

  :global(.leaflet-control-zoom a:hover) {
    background: var(--color-bg-elevated) !important;
  }

  /* Elevation chart dark theme overrides */
  :global(.elevation-control) {
    background: var(--color-surface) !important;
    border: 1px solid var(--color-border) !important;
    border-radius: var(--radius-lg) !important;
    font-family: var(--font-body) !important;
  }

  :global(.elevation-control .background) {
    fill: var(--color-surface) !important;
  }

  :global(.elevation-control .area) {
    fill: var(--color-accent) !important;
    fill-opacity: 0.3 !important;
    stroke: var(--color-accent) !important;
    stroke-width: 2 !important;
  }

  :global(.elevation-control .axis text),
  :global(.elevation-control .legend text) {
    fill: var(--color-text-secondary) !important;
    font-family: var(--font-body) !important;
    font-size: 11px !important;
  }

  :global(.elevation-control .axis line),
  :global(.elevation-control .axis path) {
    stroke: var(--color-border) !important;
  }

  :global(.elevation-control .grid line) {
    stroke: var(--color-border) !important;
    stroke-opacity: 0.3 !important;
  }

  :global(.elevation-control .mouse-focus-line) {
    stroke: var(--color-accent) !important;
  }

  :global(.elevation-summary) {
    font-family: var(--font-body) !important;
    color: var(--color-text-secondary) !important;
  }

  /* Gallery */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery-item {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    display: block;
    border: 1px solid var(--color-border);
    transition: transform 0.2s, border-color 0.2s;
  }

  .gallery-item:hover {
    transform: scale(1.02);
    border-color: var(--color-accent);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .poi-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .poi-card {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s, transform 0.2s;
  }

  .poi-card:hover {
    border-color: var(--color-text-muted);
    transform: translateY(-2px);
  }

  .poi-card__icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    margin-top: 2px;
  }

  .poi-card__content {
    flex: 1;
    min-width: 0;
  }

  .poi-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
    flex-wrap: wrap;
  }

  .poi-card__name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    line-height: 1.2;
  }

  .poi-card__type {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
  }

  .poi-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-1) 0;
    line-height: 1.4;
  }

  .poi-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
    flex-wrap: wrap;
  }

  .poi-card__maps-link {
    font-size: 0.75rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .poi-card__maps-link:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
</style>

<!-- Load Leaflet & Elevation from CDN (avoids SSR issues with Astro) -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/@raruto/leaflet-elevation/dist/leaflet-elevation.min.css" />

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline src="https://unpkg.com/@raruto/leaflet-elevation/dist/leaflet-elevation.min.js"></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const mapContainer = document.getElementById('route-map');
    if (!mapContainer) return;

    const gpxUrl = mapContainer.dataset.gpx;

    // Initialize map
    const map = L.map('route-map', {
      zoomControl: true,
      scrollWheelZoom: false,
    }).setView([19.0, 98.5], 8);

    // Dark-themed map tiles (CartoDB Dark Matter)
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(map);

    // Initialize elevation control
    const elevation = L.control.elevation({
      theme: 'lightblue-theme',
      collapsed: false,
      detached: true,
      elevationDiv: '#elevation-chart',
      autohide: false,
      height: 180,
      margins: { top: 20, right: 30, bottom: 30, left: 50 },
      summary: 'inline',
      slope: false,
      speed: false,
      acceleration: false,
      time: false,
      legend: true,
      almostOver: true,
      distanceMarkers: false,
    }).addTo(map);

    // Load GPX track
    elevation.load(gpxUrl);

    elevation.on('eledata_loaded', function(_e) {
      const bounds = elevation.getBounds();
      if (bounds && bounds.isValid()) {
        map.fitBounds(bounds, { padding: [30, 30] });
      }
    });
  });
</script>
