---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About thmaps — a motorcycle route repository for riders exploring Thailand.">
  <div class="page-header">
    <div class="container">
      <span class="section__label">About</span>
      <h1 class="page-header__title">About thmaps</h1>
      <p class="page-header__description">
        A passion project by riders, for riders. Built to help you discover Thailand's best roads.
      </p>
    </div>
  </div>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <p class="about__intro">
        <strong style="color: var(--color-text);">thmaps</strong> (Thai + Maps) is a curated repository of motorcycle routes across Thailand. Whether you're a seasoned touring rider or a first-timer on a rented Honda Wave, we want to help you find the perfect road.
      </p>
      <img
        src="https://res.cloudinary.com/dkt5mugsu/image/upload/w_1200,q_auto,f_auto/v1773936388/moe_o2h76n.jpg"
        alt="Riding through Thailand"
        style="width: 100%; border-radius: var(--radius-lg); margin-top: var(--space-8); display: block;"
      />
      <div style="margin-top: var(--space-10); text-align: center;">
        <p style="font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-4);">Get in touch</p>
        <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
          <a href="mailto:michael.rheault@gmail.com" class="btn btn--secondary">
            michael.rheault@gmail.com
          </a>
          <a href="https://www.facebook.com/ThisIsMick/" target="_blank" rel="noopener noreferrer" class="btn btn--secondary">
            https://www.facebook.com/ThisIsMick/
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
