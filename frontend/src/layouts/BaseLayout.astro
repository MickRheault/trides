---
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'Discover the best motorcycle routes across Thailand. Curated rides through mountains, coastlines, and hidden gems.', image } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} image={image} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="site-logo">th<span>maps</span></a>
        <nav>
          <ul class="site-nav">
            <li><a href="/">Home</a></li>
            <li><a href="/routes">Routes</a></li>
            <li><a href="/about">About</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} thmaps — Motorcycle Routes in Thailand</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
