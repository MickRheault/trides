---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Discover the best motorcycle routes across Thailand. Curated rides through mountains, coastlines, and hidden gems.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Trides</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="site-logo">tri<span>des</span></a>
        <nav>
          <ul class="site-nav">
            <li><a href="/">Home</a></li>
            <li><a href="/routes">Routes</a></li>
            <li><a href="/about">About</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Trides — Motorcycle Routes in Thailand</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
